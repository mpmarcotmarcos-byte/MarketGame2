<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#0B0B0F"
    tools:context=".view.ContaActivity">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Conta"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="24sp">

        </TextView>

        <ImageView
            android:layout_width="183dp"
            android:layout_height="181dp"
            android:src="@drawable/icone_avatar_conta">

        </ImageView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Nome do Individuo"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="24sp">
        </TextView>

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:layout_margin="20dp"
            android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="E-mail"></TextView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Telefone"></TextView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CPF"></TextView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Endereço"></TextView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cidade"></TextView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado"></TextView>
        </LinearLayout>

        <TextView
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            ></TextView>

        <TextView
            android:id="@+id/btnSairDaConta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sair da conta"
            android:layout_marginTop="20dp"
            android:textColor="#CD1C18"
            android:textSize="20sp"></TextView>

    <!--    <Button-->
    <!--        android:layout_width=""-->
    <!--        android:layout_height=""-->
    <!--        android:text="Logout"-->
    <!--        >-->
    <!--    </Button>-->

</LinearLayout>